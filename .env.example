# ====== REQUIRED ======
BOT_TOKEN=123456:ABC-your-telegram-bot-token
OWNER_ID=123456789

# ====== OPTIONAL ======
# Force-join channel username (without @). Leave blank to disable.
FORCE_JOIN_CHANNEL=
# Public URL of this service (used in /start when deployed). Optional.
PUBLIC_URL=
# Port for health-check web server (Render sets PORT automatically)
PORT=10000
# SQLite path
DB_PATH=bot.db

# Optional MongoDB persistence (mirrors owner settings/providers/users/groups
# so they survive re-deploys). Leave blank to run SQLite-only.
MONGODB_URI=
MONGODB_DB=xenex_bot

# Optional: path to an exported YouTube cookies file for restricted/bot-check links.
# Leave blank to use the repo-level youtube_cookies.txt if present.
YT_COOKIES_FILE=

# ====== RICH MESSAGES (Bot API 10.1, Telethon MTProto) ======
# Get these from https://my.telegram.org -> API development tools.
# When set, AI answers are sent as native Rich Messages (tables, LaTeX,
# task lists, collapsible details, quotes) and /slide can build image
# sliders. Leave blank to keep classic HTML formatting.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional StringSession (for read-only/ephemeral filesystems)
TELETHON_SESSION=
TELETHON_SESSION_NAME=rich_bot
# Set to "off" to disable rich messages even if API credentials exist
RICH_MESSAGES=on
